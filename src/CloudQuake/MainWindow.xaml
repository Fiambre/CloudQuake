<Window x:Class="CloudQuake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CloudQuake"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0D1117"
        WindowStartupLocation="Manual"
        Visibility="Hidden">
    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21262D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#161B22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="CloudQuake"
                       Foreground="#58A6FF" FontFamily="Consolas" FontWeight="Bold"
                       FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />

            <TextBlock x:Name="StatusText" Grid.Column="1" Text=""
                       Foreground="#8B949E" FontFamily="Consolas" FontSize="11"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="PinButton" Content="&#128204;" Click="PinButton_Click"
                        Style="{StaticResource TitleBarButton}" ToolTip="Keep open when it loses focus" />
                <Button x:Name="ReloadButton" Content="&#8635;" Click="ReloadButton_Click"
                        Style="{StaticResource TitleBarButton}" ToolTip="Reload" />
                <Button x:Name="SettingsButton" Content="&#9881;" Click="SettingsButton_Click"
                        Style="{StaticResource TitleBarButton}" ToolTip="Settings" />
                <Button x:Name="HideButton" Content="&#10005;" Click="HideButton_Click"
                        Style="{StaticResource TitleBarButton}" ToolTip="Hide (Esc)" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid>
                <wv2:WebView2 x:Name="WebView" />

                <Border x:Name="LoadingOverlay" Background="#0D1117" Visibility="Collapsed">
                    <TextBlock Text="Loading…" Foreground="#8B949E"
                               FontFamily="Consolas" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Shown when WebView2 cannot start (usually a missing runtime) -->
                <Border x:Name="ErrorOverlay" Background="#0D1117" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="WebView2 could not start"
                                   Foreground="#F85149" FontFamily="Consolas" FontSize="15"
                                   FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorDetailText" Text=""
                                   Foreground="#8B949E" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,12,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="#58A6FF">
                                Download the WebView2 runtime
                            </Hyperlink>
                        </TextBlock>
                        <Button Content="Retry" Click="RetryButton_Click"
                                Margin="0,20,0,0" Padding="16,6" HorizontalAlignment="Center"
                                Background="#238636" Foreground="White" BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
