<Window x:Class="CloudQuake.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudQuake — Settings"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1D9" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9D1D9" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6E7681" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="CaretBrush" Value="#C9D1D9" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Shown only on first run -->
        <Border x:Name="WelcomePanel" Background="#161B22" BorderBrush="#30363D"
                BorderThickness="1" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Welcome to CloudQuake"
                           Foreground="#58A6FF" FontWeight="Bold" FontSize="14" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                           Text="Point it at your CloudCLI instance to get started. You can change any of this later from the tray icon." />
            </StackPanel>
        </Border>

        <TextBlock Text="CloudCLI URL" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UrlBox" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="For example http://localhost:3001 for a local install, or the address of your self-hosted instance." />

        <TextBlock Text="Global hotkey" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="WinCheck" Content="Win" Margin="0,0,10,0" />
            <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="0,0,10,0" />
            <CheckBox x:Name="AltCheck" Content="Alt" Margin="0,0,10,0" />
            <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="0,0,10,0" />
            <ComboBox x:Name="KeyCombo" Width="72" />
        </StackPanel>
        <TextBlock Style="{StaticResource HintText}"
                   Text="Windows reserves most Win+&lt;letter&gt; combinations, and other apps may already own a shortcut. If it stops working, pick a different one." />

        <TextBlock Text="Show on" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" />

        <TextBlock Text="Width (% of screen)" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <Slider x:Name="WidthSlider" Minimum="0.2" Maximum="1.0"
                TickFrequency="0.05" IsSnapToTickEnabled="True" />

        <TextBlock Text="Height (% of screen)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <Slider x:Name="HeightSlider" Minimum="0.2" Maximum="1.0"
                TickFrequency="0.05" IsSnapToTickEnabled="True" />

        <CheckBox x:Name="HideOnFocusLossCheck" Content="Hide when it loses focus" Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="When off, the console stays open until you toggle it. Also togglable from the pin button in the title bar." />

        <CheckBox x:Name="NotificationsCheck" Content="Forward page notifications to Windows" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="Shows notifications from CloudCLI as Windows toasts while CloudQuake is running." />

        <CheckBox x:Name="AutoStartCheck" Content="Start with Windows" Margin="0,12,0,0" />

        <CheckBox x:Name="DiagnosticsCheck" Content="Write a troubleshooting log" Margin="0,12,0,0" />
        <TextBlock x:Name="LogPathText" Style="{StaticResource HintText}" />

        <TextBlock x:Name="ErrorText" Foreground="#F85149" FontSize="11"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Background="#21262D"
                    Click="Cancel_Click" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Save" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
