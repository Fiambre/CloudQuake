<Window x:Class="CloudQuake.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudQuake - Configuraci&#243;n"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1D9" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9D1D9" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <Label Content="URL de CloudCLI" Padding="0" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" />

        <Label Content="Hotkey global" Padding="0" Margin="0,16,0,4" />
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="WinCheck" Content="Win" Margin="0,0,10,0" />
            <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="0,0,10,0" />
            <CheckBox x:Name="AltCheck" Content="Alt" Margin="0,0,10,0" />
            <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="0,0,10,0" />
            <ComboBox x:Name="KeyCombo" Width="70" />
        </StackPanel>
        <TextBlock x:Name="HotkeyErrorText" Foreground="#F85149" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" />

        <Label Content="Ancho (% de pantalla)" Padding="0" Margin="0,16,0,4" />
        <Slider x:Name="WidthSlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" />

        <Label Content="Alto (% de pantalla)" Padding="0" Margin="0,12,0,4" />
        <Slider x:Name="HeightSlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" />

        <CheckBox x:Name="AutoStartCheck" Content="Iniciar con Windows" Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Background="#21262D" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="Guardar" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
